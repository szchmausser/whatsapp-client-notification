# WhatsApp Chat JID (format: XXXXXXXXXX@s.whatsapp.net)
CHAT_JID=

# SQLite database path
DB_PATH=./data/collector.db

# Auth directory for WhatsApp session
AUTH_DIR=./auth

# Capture direction: incoming, outgoing, or both
CAPTURE_DIRECTION=incoming

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
